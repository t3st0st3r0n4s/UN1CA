# SPDX-License-Identifier: Apache-2.0
# PROVISIONAL UN1CA r0s updater-script BLOCK MAP, NOT a validated Samsung One UI 8 recovery fstab.
# Locators verified against extracted Samsung GZH3 vendor/etc/fstab.s5e9925.
# This is NOT verified against the native stock recovery ramdisk or updater.
# DO NOT USE ON DEVICE; target/r0s/installer/assertions.edify must retain E3099 abort.
# Dynamic partitions are resolved by UN1CA to map_partition(name), not raw blocks.
system /system erofs ro wait,logical,first_stage_mount
vendor /vendor erofs ro wait,logical,first_stage_mount
product /product erofs ro wait,logical,first_stage_mount
vendor_dlkm /vendor_dlkm erofs ro wait,logical,first_stage_mount
odm /odm auto ro wait,logical,first_stage_mount
# Native vendor fstab verifies these locators; recovery updater unqualified.
/dev/block/by-name/boot /boot emmc defaults recoveryonly
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults recoveryonly
/dev/block/by-name/dtbo /dtbo emmc defaults recoveryonly
/dev/block/by-name/recovery /recovery emmc defaults recoveryonly
